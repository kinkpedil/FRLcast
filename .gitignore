# Piper TTS commentary voice: the binary + voice models the operator drops here for the
# local /api/tts route. Big binaries, machine-specific — not tracked.
tools/piper/

# Desktop download build output (scripts/package-desktop.ps1): bundled Node + app + zip.
dist/

# Remotion render output (the recap-video PoC). The source under remotion/src is tracked;
# the rendered mp4s and Remotion's bundle cache are not.
remotion/out/
remotion/.remotion/

# Internal/private docs: kept on the operator's disk, never in the public repo.
# (sesi-lama.md holds private third-party correspondence; CLAUDE.md / FRLCAST_CONTEXT.md
# are internal project notes.)
sesi-lama.md
CLAUDE.md
FRLCAST_CONTEXT.md

# Generated into site/ by site/prepare.sh on every deploy — copies of public/ plus the
# built APK and the cache-bust stamp. Regenerated each deploy, so not tracked. (The
# authored site pages — index/login/dashboard/event/recap, styles.css, app.js, i18n.js,
# vercel.json, supabase-config.js, fonts, shots — stay tracked.)
site/overlay/
site/js/
site/css/
site/console.html
site/report.html
site/live.html
site/multiview.html
site/dl/
site/version.txt
